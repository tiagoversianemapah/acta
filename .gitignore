# Ambiente virtual e artefatos de build
.venv/
*.egg-info/
__pycache__/
*.py[cod]
dist/
build/

# Gerados pelo empacotar/construir.py a partir de marca.py — não são fonte
empacotar/*.ico
empacotar/versao.txt

# Dados de operação: banco, PDFs, evidências, logs, perfis de navegador.
# É o estado da máquina, nunca vai para o controle de versão.
data/

# Planilhas de clientes — contêm CNPJ/CPF de terceiros (RNF-06)
*.xlsx
*.xls

# Configuração local com credenciais.
#
# O config.toml de cada máquina traz a senha do painel, o endereço dela na
# rede e o número do AnyDesk — nada disso é do programa, é da instalação.
# Ele já esteve versionado, e a senha viajava junto: por isso saiu do
# histórico inteiro em 18/08/2026, antes do repositório ir para o GitHub.
# Quem for instalar copia o config.exemplo.toml e preenche; segredo mesmo
# é melhor pela variável de ambiente (CND_REDE_SENHA, CND_SMTP_SENHA).
config.toml
config.local.toml

# Editor / SO
.vscode/
.idea/
Thumbs.db
desktop.ini
